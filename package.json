{
  "name": "project-drift",
  "displayName": "Project Drift",
  "description": "Find comments your code has outgrown. Flags code comments that have fallen out of sync with the code they describe, using git history.",
  "version": "0.0.1",
  "publisher": "melvinbalajadia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melvin-balajadia/project-drift.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "comments",
    "git",
    "blame",
    "documentation",
    "stale",
    "drift"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectDrift.markAccurate",
        "title": "Mark Comment as Still Accurate",
        "category": "Project Drift"
      },
      {
        "command": "projectDrift.showDiff",
        "title": "Show Changes Since Comment",
        "category": "Project Drift"
      },
      {
        "command": "projectDrift.clearDismissals",
        "title": "Clear All Dismissals",
        "category": "Project Drift"
      },
      {
        "command": "projectDrift.toggleDecorations",
        "title": "Toggle Decorations",
        "category": "Project Drift"
      },
      {
        "command": "projectDrift.devAnalyze",
        "title": "Analyze Active File (dev)",
        "category": "Project Drift"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectDrift.showDiff",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Project Drift",
      "properties": {
        "projectDrift.threshold": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "Number of newer commits to a comment's code before the comment is flagged."
        },
        "projectDrift.maxScopeLines": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of code lines considered to belong to a comment."
        },
        "projectDrift.showInProblems": {
          "type": "boolean",
          "default": false,
          "description": "Also report drifted comments in the Problems panel."
        }
      }
    },
    "colors": [
      {
        "id": "projectDrift.driftBackground",
        "description": "Background of drifted comment lines.",
        "defaults": {
          "dark": "#ffb80014",
          "light": "#ffb80022"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:integration": "npm run build && tsc && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  }
}
