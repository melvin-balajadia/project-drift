{
  "name": "project-drift",
  "displayName": "Project Drift",
  "description": "Find comments your code has outgrown. Flags code comments that have fallen out of sync with the code they describe, using git history.",
  "version": "1.0.1",
  "publisher": "melvinbalajadia",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melvin-balajadia/project-drift.git"
  },
  "homepage": "https://github.com/melvin-balajadia/project-drift#readme",
  "bugs": {
    "url": "https://github.com/melvin-balajadia/project-drift/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "comments",
    "outdated",
    "stale",
    "git",
    "blame",
    "documentation",
    "drift"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectDrift.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Project Drift",
        "icon": "$(refresh)"
      },
      {
        "command": "projectDrift.markAccurate",
        "title": "Mark Comment as Still Accurate",
        "category": "Project Drift",
        "icon": "$(check)"
      },
      {
        "command": "projectDrift.showDiff",
        "title": "Show Changes Since Comment",
        "category": "Project Drift",
        "icon": "$(diff)"
      },
      {
        "command": "projectDrift.clearDismissals",
        "title": "Clear All Dismissals",
        "category": "Project Drift"
      },
      {
        "command": "projectDrift.toggleDecorations",
        "title": "Toggle Decorations",
        "category": "Project Drift"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "projectDrift.showDiff",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "projectDrift.scanWorkspace",
          "when": "view == projectDrift.driftList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "projectDrift.markAccurate",
          "when": "view == projectDrift.driftList && viewItem == driftItem",
          "group": "inline"
        },
        {
          "command": "projectDrift.markAccurate",
          "when": "view == projectDrift.driftList && viewItem == driftItem",
          "group": "drift@1"
        },
        {
          "command": "projectDrift.showDiff",
          "when": "view == projectDrift.driftList && viewItem == driftItem",
          "group": "drift@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectDrift",
          "title": "Project Drift",
          "icon": "media/drift.svg"
        }
      ]
    },
    "views": {
      "projectDrift": [
        {
          "id": "projectDrift.driftList",
          "name": "Drifted Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectDrift.driftList",
        "contents": "No drifted comments found yet.\n[Scan Workspace](command:projectDrift.scanWorkspace)",
        "when": "projectDrift.hasRepo"
      },
      {
        "view": "projectDrift.driftList",
        "contents": "Open a git repository to use Project Drift.\n[Open Folder](command:vscode.openFolder)",
        "when": "!projectDrift.hasRepo"
      }
    ],
    "configuration": {
      "title": "Project Drift",
      "properties": {
        "projectDrift.threshold": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "Number of newer commits to a comment's code before the comment is flagged."
        },
        "projectDrift.maxScopeLines": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of code lines considered to belong to a comment."
        },
        "projectDrift.showInProblems": {
          "type": "boolean",
          "default": false,
          "description": "Also report drifted comments in the Problems panel."
        },
        "projectDrift.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/vendor/**",
            "**/*.min.js"
          ],
          "description": "Glob patterns to skip during workspace scans."
        },
        "projectDrift.maxFileSizeKB": {
          "type": "integer",
          "default": 512,
          "minimum": 1,
          "description": "Files larger than this are skipped."
        }
      }
    },
    "colors": [
      {
        "id": "projectDrift.driftBackground",
        "description": "Background of drifted comment lines.",
        "defaults": {
          "dark": "#ffb80014",
          "light": "#ffb80022"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:integration": "npm run build && node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
